<mxfile host="app.diagrams.net">
  <diagram name="Zomato Recommendation System">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1"
      pageScale="1" pageWidth="1600" pageHeight="1000"
      math="0" shadow="0">

      <root>

        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- OFFLINE LANE -->

        <mxCell id="offlineLane"
          value="OFFLINE PROCESSING"
          style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;"
          vertex="1"
          parent="1">
          <mxGeometry x="20" y="20" width="700" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="dataset"
          value="Zomato Dataset&#10;&#10;Restaurant Metadata&#10;Reviews&#10;Ratings&#10;Votes"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="offlineLane">
          <mxGeometry x="150" y="60" width="350" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="reviewEngine"
          value="Review Intelligence Engine&#10;&#10;• Sentiment Analysis&#10;• Aspect-Based Analysis&#10;(Food, Ambiance, Service, Authenticity)"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="offlineLane">
          <mxGeometry x="120" y="240" width="400" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="enrichedStore"
          value="Enriched Restaurant Store&#10;&#10;Food Score&#10;Ambiance Score&#10;Authenticity Score&#10;Service Score&#10;Sentiment Score"
          style="shape=cylinder;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="offlineLane">
          <mxGeometry x="140" y="470" width="360" height="140" as="geometry"/>
        </mxCell>

        <!-- ONLINE LANE -->

        <mxCell id="onlineLane"
          value="ONLINE RECOMMENDATION FLOW"
          style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;"
          vertex="1"
          parent="1">
          <mxGeometry x="820" y="20" width="700" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="userQuery"
          value="User Query&#10;&#10;Natural Language Input"
          style="ellipse;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="180" y="60" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="nlp"
          value="Natural Language Query Processing&#10;&#10;Intent Extraction&#10;Entity Extraction&#10;Ambiguity Handling"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="120" y="190" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="retrieval"
          value="Candidate Restaurant Retrieval&#10;&#10;Location Filter&#10;Online Order Filter&#10;Table Booking Filter"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="120" y="380" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="matching"
          value="Cuisine + Budget Matching Engine"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="120" y="570" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ranking"
          value="Ranking Engine&#10;&#10;Rating Score&#10;Votes Score&#10;Cuisine Match&#10;Budget Match&#10;Sentiment Score&#10;Aspect Scores"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="120" y="710" width="380" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="recommendation"
          value="Recommendation &amp; Explainability Layer"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="560" y="710" width="120" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="topN"
          value="Top-N Recommended Restaurants"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1"
          parent="onlineLane">
          <mxGeometry x="560" y="470" width="120" height="120" as="geometry"/>
        </mxCell>

        <!-- OFFLINE CONNECTIONS -->

        <mxCell id="e1"
          style="endArrow=block;"
          edge="1"
          parent="offlineLane"
          source="dataset"
          target="reviewEngine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2"
          style="endArrow=block;"
          edge="1"
          parent="offlineLane"
          source="reviewEngine"
          target="enrichedStore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ONLINE CONNECTIONS -->

        <mxCell id="e3"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="userQuery"
          target="nlp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="nlp"
          target="retrieval">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="retrieval"
          target="matching">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="matching"
          target="ranking">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="ranking"
          target="recommendation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8"
          style="endArrow=block;"
          edge="1"
          parent="onlineLane"
          source="recommendation"
          target="topN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CROSS-LANE CONNECTION -->

        <mxCell id="e9"
          value="Feature Store Access"
          style="dashed=1;endArrow=block;strokeColor=#ff0000;"
          edge="1"
          parent="1"
          source="enrichedStore"
          target="ranking">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>